; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Great Search"
run/main_scene="res://Scenes/adafruit_presents_root.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DialogManager="*res://Singletons/DialogManager.gd"
InteractionManager="*res://Scenes/InteractionManager.tscn"
Global="*res://global.gd"
SceneTransitionObject="res://SceneTransition.gd"
SceneTransition="*res://Scenes/Apt Scene/Objects/scene_transition.tscn"
RespawnGlobal="*res://Scripts/respawn_global.gd"
CollectibleSingleton="*res://Assests/Collectible/CollectibleSingleton.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"

